<?xml version="1.0" encoding="UTF-8"?>
<!--
	Navezgane Hospital Challenge — Game Events
	Author: Frilioth
	Version: 1.3.0

	Replaces first spawn loadout with hospital-appropriate items.

	v1.3.0: Hunting Knife added to the loadout in slot 6. The starting weapon
	CHOICE has been removed entirely — every run now starts with the same fixed
	kit. Previously the weapon came from the DLL based on a New Game menu row
	(Knife / Bat / Spear / Bow), which is gone along with XUiC_HospitalWeaponChoice
	and the FrilHospital_WeaponChoice PlayerPref.
	All six vanilla item ids verified present in 3.2 items.xml.
-->
<configs>
	<set xpath="/gameevents/action_sequence[@name='game_first_spawn']">
		<property name="allow_user_trigger" value="false" />
		<property name="action_type" value="Game" />
		<action class="Delay">
			<property name="phase" value="1" />
			<property name="time" value="5" />
		</action>
		<action class="SetItemSlots">
			<property name="items_location" value="Toolbelt" />
			<property name="items" value="hospitalSurvivalGuide,meleeToolRepairT0StoneAxe,medicalFirstAidBandage,drinkJarBoiledWater,foodCanChili,hospitalSuppressantStrong,meleeWpnBladeT1HuntingKnife" />
			<property name="item_counts" value="1,1,2,2,2,1,1" />
			<property name="slot_numbers" value="0,1,2,3,4,5,6" />
		</action>
	</set>

	<!-- Reward for completing Phase 1: Clear the Ward -->
	<append xpath="/gameevents">
		<action_sequence name="hospital_reward_assess">
    <property name="action_type" value="Game" />
    <action class="AddItems">
        <property name="added_items" value="armorPrimitiveHelmet,armorPrimitiveOutfit,armorPrimitiveGloves,armorPrimitiveBoots,meleeToolSalvageT1Wrench,modArmorHelmetLight" />
        <property name="added_item_counts" value="1,1,1,1,1,1" />
    </action>
    <action class="AddSkillPoints">
        <property name="skill_points" value="4" />
    </action>
</action_sequence>
	</append>
</configs>