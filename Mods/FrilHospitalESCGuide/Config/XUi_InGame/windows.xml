<?xml version='1.0' encoding='UTF-8'?>
<FrilHospitalESCGuide>

   <!--
      Hospital Challenge ESC guide window. Pure XML, no DLL.

      v1.0.1: all three body labels raised to font_size 28 (were 26 / 24 / 26).
      All three tabs finished around two thirds down the panel at the smaller
      sizes, so there was room to spare. Emphasis colour in the copy moved from
      a hardcoded [e4e4e8] to [f4f6fa] / hcPageAccentColor, because e4e4e8 was
      identical to hcPageBodyColor and every emphasis tag was therefore invisible.

      GEOMETRY: window anchored CenterCenter, all content inside a "core" rect at
      pos="-560,400" (the top-left corner of the centred box). Content flows
      RIGHT (+X) and DOWN (-Y) from there.

      LABEL CENTRING, the trap worth knowing: a label with justify="center" centres
      its text across its PARENT rect's width. A centred title therefore sits at
      pos="0" inside a full-width (1100) parent, NOT at pos="550". Putting the label
      itself at 550 shoves it off the right-hand edge.

      TAB BUTTONS: the grid uses repeat_content="true" with ONE template rect. The
      engine repeats it once per TabSelectorTab found below and fills the caption
      from that tab's tab_key, via the {tab_name_localized} binding. Adding a fourth
      page therefore means adding a page rect AND widening the grid maths below - the
      button strip does not resize itself.

      GRID CENTRING MATHS: 3 cells x 204 = 612 wide. Centred under 1100 means
      starting at (1100 - 612) / 2 = 244. Change the column count and this must be
      recalculated or the strip sits off-centre.

      Controllers TabSelector / TabSelectorButton / TabSelectorTab are vanilla and
      confirmed present in 3.2. Technique credit: AuroraGiggleFairy (AGF-ESCWindow).
      Fresh Hospital build, not a reskin. All text is a text_key into
      Config/Localization.csv.

      A comment here must never contain a double hyphen; the game rejects the file.
   -->

   <append xpath="/windows">
      <window name="windowHospitalESC" depth="10" width="1200" height="820" anchor="CenterCenter" cursor_area="true">
         <rect name="tabs" controller="TabSelector" select_tab_contents_on_open="true">

            <!-- Content origin: top-left of the centred box. -->
            <rect name="core" pos="-560,400" disableautobackground="true">

               <!-- HEADER -->
               <rect name="header" pos="0,0" width="1100" height="120">
                  <sprite name="headerBg" depth="2" pos="5,-5" sprite="ui_game_header_fill" color="[hcHeaderBgColor]" width="1090" height="110" type="sliced"/>
                  <sprite name="headerBorder" depth="1" sprite="ui_game_header_fill" color="[hcPanelBorderColor]" width="1100" height="120" type="sliced"/>
                  <label name="headerTitle" depth="10" pos="0,-24" width="1100" justify="center" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[hcHeaderTitleColor]" font_size="46" text_key="hcesc_header_title" foregroundlayer="true"/>
                  <label name="headerMotto" depth="10" pos="0,-76" width="1100" justify="center" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[hcHeaderMottoColor]" font_size="24" text_key="hcesc_header_motto" foregroundlayer="true"/>
               </rect>

               <!-- TAB BUTTON STRIP -->
               <rect name="tabsHeader">
                  <grid name="tabButtons" pos="142,-130" depth="12" rows="1" cols="4" cell_width="204" cell_height="48" repeat_content="true" arrangement="horizontal">
                     <rect controller="TabSelectorButton">
                        <simplebutton name="tabButton" depth="12" pos="0,0" width="200" height="46" font_size="26" sprite="ui_game_header_fill" bordercolor="[hcTabBorderColor]" defaultcolor="[hcTabBgColor]" selectedsprite="menu_empty3px" selectedcolor="[hcTabSelectedColor]" foregroundlayer="false" caption="{tab_name_localized}"/>
                     </rect>
                  </grid>
               </rect>

               <!-- TAB PAGES -->
               <rect name="tabsContents">

                  <rect name="page_diagnosis" controller="TabSelectorTab" tab_key="hcesc_tab_diagnosis">
                     <rect name="body" pos="0,-186" width="1100" height="620">
                        <sprite name="bodyBg" depth="2" pos="5,-5" sprite="ui_game_header_fill" color="[hcPageBgColor]" width="1090" height="610" type="sliced"/>
                        <sprite name="bodyBorder" depth="1" sprite="ui_game_header_fill" color="[hcPanelBorderColor]" width="1100" height="620" type="sliced"/>
                        <label name="title" depth="10" pos="0,-30" width="1100" justify="center" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[hcPageTitleColor]" font_size="34" text_key="hcesc_diagnosis_title" foregroundlayer="true"/>
                        <label name="text" depth="10" pos="40,-96" width="1020" height="500" justify="left" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[hcPageBodyColor]" font_size="28" text_key="hcesc_diagnosis_body" foregroundlayer="true"/>
                     </rect>
                  </rect>

                  <rect name="page_symptoms" controller="TabSelectorTab" tab_key="hcesc_tab_symptoms">
                     <rect name="body" pos="0,-186" width="1100" height="620">
                        <sprite name="bodyBg" depth="2" pos="5,-5" sprite="ui_game_header_fill" color="[hcPageBgColor]" width="1090" height="610" type="sliced"/>
                        <sprite name="bodyBorder" depth="1" sprite="ui_game_header_fill" color="[hcPanelBorderColor]" width="1100" height="620" type="sliced"/>
                        <label name="title" depth="10" pos="0,-30" width="1100" justify="center" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[hcPageTitleColor]" font_size="34" text_key="hcesc_symptoms_title" foregroundlayer="true"/>
                        <label name="text" depth="10" pos="40,-96" width="1020" height="500" justify="left" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[hcPageBodyColor]" font_size="28" text_key="hcesc_symptoms_body" foregroundlayer="true"/>
                     </rect>
                  </rect>

                  <rect name="page_treatment" controller="TabSelectorTab" tab_key="hcesc_tab_treatment">
                     <rect name="body" pos="0,-186" width="1100" height="620">
                        <sprite name="bodyBg" depth="2" pos="5,-5" sprite="ui_game_header_fill" color="[hcPageBgColor]" width="1090" height="610" type="sliced"/>
                        <sprite name="bodyBorder" depth="1" sprite="ui_game_header_fill" color="[hcPanelBorderColor]" width="1100" height="620" type="sliced"/>
                        <label name="title" depth="10" pos="0,-30" width="1100" justify="center" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[hcPageTitleColor]" font_size="34" text_key="hcesc_treatment_title" foregroundlayer="true"/>
                        <label name="text" depth="10" pos="40,-96" width="1020" height="500" justify="left" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[hcPageBodyColor]" font_size="28" text_key="hcesc_treatment_body" foregroundlayer="true"/>
                     </rect>
                  </rect>

                  <rect name="page_prognosis" controller="TabSelectorTab" tab_key="hcesc_tab_prognosis">
                     <rect name="body" pos="0,-186" width="1100" height="620">
                        <sprite name="bodyBg" depth="2" pos="5,-5" sprite="ui_game_header_fill" color="[hcPageBgColor]" width="1090" height="610" type="sliced"/>
                        <sprite name="bodyBorder" depth="1" sprite="ui_game_header_fill" color="[hcPanelBorderColor]" width="1100" height="620" type="sliced"/>
                        <label name="title" depth="10" pos="0,-30" width="1100" justify="center" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[hcPageTitleColor]" font_size="34" text_key="hcesc_prognosis_title" foregroundlayer="true"/>
                        <label name="text" depth="10" pos="40,-96" width="1020" height="500" justify="left" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[hcPageBodyColor]" font_size="28" text_key="hcesc_prognosis_body" foregroundlayer="true"/>
                     </rect>
                  </rect>

               </rect>
            </rect>
         </rect>
      </window>
   </append>

</FrilHospitalESCGuide>